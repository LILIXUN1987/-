/* ── 全局样式 ── */
page {
  background-color: #f9fafb;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  color: #1f2937;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* ── 按钮 ── */
.btn-primary {
  background-color: #1a56db;
  color: #fff;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  transition: opacity 0.2s;
  border: none;
  width: 100%;
  line-height: 1.4;
}
.btn-primary:active { opacity: 0.8; }
.btn-primary[disabled] { opacity: 0.5; }

.btn-outline {
  border: 2rpx solid #d1d5db;
  color: #374151;
  padding: 22rpx 32rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  text-align: center;
  background: #fff;
  width: 100%;
  line-height: 1.4;
}
.btn-outline:active { background-color: #f9fafb; }

.btn-small {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
  width: auto;
  display: inline-flex;
  align-items: center;
}

/* ── 输入框 ── */
.input-field {
  width: 100%;
  padding: 24rpx 28rpx;
  border: 2rpx solid #d1d5db;
  border-radius: 16rpx;
  font-size: 28rpx;
  background: #fff;
  box-sizing: border-box;
}
.input-field:focus {
  border-color: #1a56db;
}

/* ── 卡片 ── */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

/* ── 标签 ── */
.tag {
  display: inline-flex;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.tag-primary { background: #e8effd; color: #1a56db; }
.tag-green { background: #dcfce7; color: #16a34a; }
.tag-red { background: #fee2e2; color: #dc2626; }
.tag-yellow { background: #fef3c7; color: #d97706; }

/* ── 空状态 ── */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #9ca3af;
}
.empty-state image {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
}
.empty-state text {
  display: block;
  font-size: 28rpx;
}

/* ── 分隔线 ── */
.divider {
  height: 2rpx;
  background: #f3f4f6;
  margin: 16rpx 0;
}

/* ── 加载 ── */
.loading-center {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
}
