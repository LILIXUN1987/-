.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  background: linear-gradient(135deg, #eff6ff 0%, #e8effd 100%);
}
.login-header { text-align: center; margin-bottom: 60rpx; }
.logo { font-size: 80rpx; margin-bottom: 16rpx; }
.title { font-size: 36rpx; font-weight: 700; color: #1f2937; display: block; }
.subtitle { font-size: 26rpx; color: #6b7280; margin-top: 8rpx; display: block; }
.login-form { width: 100%; max-width: 600rpx; }
.form-item { margin-bottom: 24rpx; }
.error-msg {
  background: #fee2e2;
  color: #dc2626;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}
.register-link { text-align: center; margin-top: 32rpx; font-size: 26rpx; color: #6b7280; }
.link { color: #1a56db; margin-left: 8rpx; }
