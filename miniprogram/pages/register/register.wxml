<view style="padding:40rpx 32rpx;min-height:100vh;background:linear-gradient(135deg,#eff6ff 0%,#f9fafb 100%);">
  <text style="font-size:36rpx;font-weight:700;display:block;margin-bottom:32rpx;text-align:center;">账号注册</text>
  <view style="display:flex;flex-direction:column;gap:20rpx;">
    <view style="display:flex;gap:16rpx;">
      <view class="{{form.role==='trader'?'role-active':'role-inactive'}}" data-role="trader" bindtap="selectRole" style="flex:1;text-align:center;padding:20rpx;border-radius:16rpx;font-size:26rpx;">
        🌏 外贸行业
      </view>
      <view class="{{form.role==='forwarder'?'role-active':'role-inactive'}}" data-role="forwarder" bindtap="selectRole" style="flex:1;text-align:center;padding:20rpx;border-radius:16rpx;font-size:26rpx;">
        🚚 货运代理
      </view>
    </view>
    <view wx:if="{{error}}" style="background:#fee2e2;color:#dc2626;padding:16rpx 24rpx;border-radius:12rpx;font-size:26rpx;">{{error}}</view>
    <input class="input-field" placeholder="真实姓名" value="{{form.display_name}}" data-field="display_name" bindinput="update" />
    <input class="input-field" placeholder="公司全称" value="{{form.company_name}}" data-field="company_name" bindinput="update" />
    <view style="display:flex;gap:12rpx;">
      <input class="input-field" placeholder="邮箱" value="{{form.email}}" data-field="email" bindinput="update" style="flex:1;" />
      <button class="btn-outline code-btn" bindtap="sendCode" disabled="{{codeSending}}">{{codeSending ? '发送中' : '获取验证码'}}</button>
    </view>
    <input wx:if="{{codeSent}}" class="input-field" placeholder="6位验证码" value="{{form.emailCode}}" data-field="emailCode" bindinput="update" maxlength="6" />
    <input class="input-field" placeholder="用户名" value="{{form.username}}" data-field="username" bindinput="update" />
    <input class="input-field" placeholder="密码" type="password" value="{{form.password}}" data-field="password" bindinput="update" />
    <input wx:if="{{form.role!=='trader'}}" class="input-field" placeholder="手机号" value="{{form.phone}}" data-field="phone" bindinput="update" />
    <button class="btn-primary" bindtap="submit" disabled="{{loading}}">{{loading ? '注册中...' : '提交注册'}}</button>
  </view>
</view>
