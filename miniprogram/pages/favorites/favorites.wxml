<view class="favorites-page">
  <view wx:if="{{loading}}" class="loading-center"><text>加载中...</text></view>
  <view wx:elif="{{items.length === 0}}" class="empty-state">
    <text>暂无收藏</text>
    <text style="font-size:24rpx;margin-top:12rpx;color:#9ca3af">在搜索结果中点 ⭐ 即可收藏</text>
  </view>
  <view wx:else>
    <view wx:for="{{items}}" wx:key="id" class="card" style="margin-bottom:16rpx;padding:24rpx;">
      <view class="route-row" style="display:flex;align-items:center;gap:8rpx;margin-bottom:8rpx;flex-wrap:wrap;">
        <text style="font-size:28rpx;font-weight:600;color:#1a56db;">{{item.origin_port || '?'}}</text>
        <text style="color:#d1d5db;">→</text>
        <text style="font-size:28rpx;font-weight:600;color:#1f2937;">{{item.dest_port || '?'}}</text>
        <text wx:if="{{item.airline_code}}" class="tag tag-primary">{{item.airline_code}}</text>
      </view>
      <text wx:if="{{item.notes}}" style="font-size:24rpx;color:#6b7280;display:block;margin-bottom:8rpx;">{{item.notes}}</text>
      <view style="display:flex;justify-content:space-between;align-items:center;">
        <text style="font-size:22rpx;color:#9ca3af;">{{item.favorited_at?.substring(5, 16)}}</text>
        <button class="btn-small btn-outline" data-id="{{item.id}}" bindtap="remove">取消收藏</button>
      </view>
    </view>
  </view>
</view>
