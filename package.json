{
  "name": "logistics-platform",
  "version": "1.0.0",
  "private": true,
  "description": "123共享外贸物流社区",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm -w backend run dev",
    "dev:frontend": "npm -w frontend run dev",
    "build": "npm -w frontend run build",
    "db:migrate": "npm -w backend run db:migrate",
    "db:seed": "npm -w backend run db:seed"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^8.2.2",
    "qrcode": "^1.5.4"
  },
  "dependencies": {
    "alipay-sdk": "^4.14.0",
    "compression": "^1.8.1",
    "nodemailer": "^8.0.10",
    "tencentcloud-sdk-nodejs-ocr": "^4.1.259",
    "web-push": "^3.6.7"
  }
}
