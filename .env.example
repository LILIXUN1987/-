# ═══════════════════════════════════════
# 123共享外贸物流社区 — 环境变量模板
# 复制为 .env 后填入真实值
# ═══════════════════════════════════════

# Server
PORT=3001
NODE_ENV=production

# Database (sqlite3 or pg)
DATABASE_CLIENT=sqlite3
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=logistics
DATABASE_USER=postgres
DATABASE_PASSWORD=

# JWT — 生产环境必须用强随机密钥
# 生成方式: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=24h

# AI Provider: deepseek or claude
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Frontend URL (CORS)
FRONTEND_URL=https://123cargo123.com

# Upload
UPLOAD_MAX_SIZE_MB=20
UPLOAD_DIR=./uploads

# SMTP — 阿里企业邮箱
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=123共享外贸物流社区

# Tencent Cloud OCR
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=

# 支付宝电脑网站支付
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://123cargo123.com/api/payment/notify

# 微信官方支付
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_APP_SECRET=
WECHAT_NOTIFY_URL=https://123cargo123.com/api/payment/notify

# Web Push (VAPID)
# 生成方式: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@tiangaocargo.com
